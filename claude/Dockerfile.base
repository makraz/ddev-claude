#ddev-generated
# ---------------------------------------------------------------------------
# Per-project sidecar Dockerfile template (v0.3.0+).
#
# The heavy lifting (packages, claude binary, claude user, sudoers entry) is
# done in the pre-built image referenced by FROM. This file is the TEMPLATE
# build-image.sh works against; it inlines selected extras at the marker
# below.
# ---------------------------------------------------------------------------
FROM ghcr.io/makraz/ddev-claude-base:v0.4.0-beta.1

USER root
COPY init-firewall.sh /usr/local/bin/init-firewall.sh
COPY entrypoint.sh    /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/init-firewall.sh /usr/local/bin/entrypoint.sh

# Bake the build-time outbound allow-list into the image at a ROOT-OWNED path
# OUTSIDE the bind-mounted project tree. init-firewall.sh reads only this copy,
# so the unprivileged `claude` user (remapped to the host's uid/gid at
# container start by entrypoint.sh, but never root) cannot append domains to
# its own allow-list and re-run the firewall to widen egress. extra-domains.list is
# generated by build-image.sh (from .ddev/claude.yaml) before the build; it is
# always present (possibly empty). Changing it requires `ddev claude rebuild`.
COPY extra-domains.list /etc/claude-firewall/extra-domains.list
RUN chmod 0644 /etc/claude-firewall/extra-domains.list

# Bake the tool allow-list, the plugin set and the shim at ROOT-OWNED paths
# OUTSIDE the bind-mounted project tree — same reasoning as extra-domains.list
# above. The agent can edit .ddev/claude.yaml (it is in the project tree), but
# that only takes effect via `ddev claude rebuild`, under the user's control.
COPY settings.json /etc/claude-sandbox/settings.json
COPY tools.list    /etc/claude-sandbox/tools.list
COPY claude-shim   /usr/local/bin/claude
RUN chmod 0644 /etc/claude-sandbox/settings.json /etc/claude-sandbox/tools.list \
 && chmod 0755 /usr/local/bin/claude

# /usr/local/bin must precede the real binary's directory so the shim wins.
ENV PATH="/usr/local/bin:/home/claude/.local/bin:${PATH}"

# NOTE: we deliberately do NOT add `env_keep += EXTRA_ALLOWED_DOMAINS` to
# sudoers. Preserving that env var across `sudo init-firewall.sh` would let the
# unprivileged agent inject arbitrary domains (export it in its own shell, then
# re-run the firewall) and widen its egress. Instead, the trusted host-set
# EXTRA_ALLOWED_DOMAINS is consumed once, at container start, by entrypoint.sh
# (genuine root, trusted compose env) which persists it to the root-owned
# /etc/claude-firewall/runtime-domains.list that init-firewall.sh reads.

# ---- EXTRAS INJECTION POINT ----
# build-image.sh replaces the marker line below with the concatenated
# contents of every selected claude/extras/<name>.fragment, followed by
# .ddev/claude.local/Dockerfile.fragment if it exists. Fragments execute as
# root (the current USER context here). If a fragment switches USER, it must
# restore `USER root` before its end.
# {{EXTRAS}}
# --------------------------------

USER claude
WORKDIR /var/www/html
