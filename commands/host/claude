#!/usr/bin/env bash
#ddev-generated
## Description: Run Claude Code inside the sandboxed sidecar container (YOLO mode)
## Usage: claude [subcommand|extra args]
## Example: ddev claude
## Example: ddev claude safe
## Example: ddev claude shell
## Example: ddev claude exec composer install
## Example: ddev claude rebuild
## Example: ddev claude help
## Example: ddev claude --resume
##
## Subcommands:
##   safe              Launch without --dangerously-skip-permissions
##   shell             Drop into bash inside the sidecar
##   exec <cmd> ...    Run one command in the sidecar non-interactively
##   rebuild           Regenerate .ddev/claude/Dockerfile from .ddev/claude.yaml
##   help              Print this help
##
## Anything else (including flags like --resume) is passed through to the
## claude CLI unchanged.
##
## Back-compat: CLAUDE_SAFE=1 ddev claude still works.

set -euo pipefail

CONTAINER="ddev-${DDEV_SITENAME:-}-claude"

ensure_running() {
  if ! docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    echo "error: sidecar container '$CONTAINER' is not running" >&2
    echo "hint:  run 'ddev start' to bring it up" >&2
    exit 1
  fi
}

ensure_firewall() {
  # Re-assert the firewall (idempotent safety net; it is also activated at
  # container start by entrypoint.sh). `--ensure` fast-paths to a near-instant
  # no-op when the firewall is already healthy, so it skips the full reset,
  # per-domain DNS resolution, and curl smoke tests on every invocation; a full
  # rebuild still runs when the health check fails (e.g. start-time init failed).
  #
  # We do NOT forward EXTRA_ALLOWED_DOMAINS here: honoring it on the `sudo` path
  # would let the in-container agent inject domains by exporting the var itself.
  # The allow-list is read only from root-owned files; EXTRA_ALLOWED_DOMAINS is
  # consumed once, at start, by entrypoint.sh — so set it before `ddev start` /
  # `ddev restart`.
  #
  # init-firewall.sh's log() helper writes to stdout even on the healthy
  # no-op path, which would otherwise leak into the stdout of whatever
  # command the caller is running (e.g. `ddev claude exec`). Capture its
  # combined output ourselves and only emit it (to stderr) when the health
  # check actually fails, so a real firewall problem still surfaces.
  local out
  local status=0
  out="$(docker exec "$CONTAINER" sudo /usr/local/bin/init-firewall.sh --ensure 2>&1)" || status=$?
  if [[ "$status" -ne 0 ]]; then
    printf '%s\n' "$out" >&2
  fi
  return "$status"
}

# Refuse to launch against a project tree that is not actually there.
#
# Under Mutagen the sidecar reads the synced volume; while the sync is still
# scanning or staging, /var/www/html is empty or half-populated and the agent
# will confidently report that your files do not exist. A wrong answer is worse
# than a refusal.
ensure_workspace() {
  local mode status
  mode="$(cat "${DDEV_APPROOT}/.ddev/claude/.mount-mode" 2>/dev/null || echo bind)"

  if [[ "$mode" == "mutagen" ]]; then
    status="$(ddev mutagen status 2>&1 | head -1)"
    # Allow-list, not deny-list: DDEV's mutagen status vocabulary can gain or
    # rename states (initializing, halted, paused, waiting, ...) that this
    # guard has never seen. A deny-list would silently pass on any of those
    # and let the agent report confidently on a half-synced tree. Only the
    # one verified settled state passes here; everything else refuses.
    case "$status" in
      *watching*)
        return 0
        ;;
      *)
        echo "error: project files are not ready in the sidecar" >&2
        echo "       $status" >&2
        echo "hint:  wait for the sync to settle, then re-run. Watch it with: ddev mutagen status" >&2
        echo "hint:  or set mount_mode: bind in .ddev/claude.yaml to skip the Mutagen check entirely" >&2
        exit 1
        ;;
    esac
  fi

  if ! docker exec "$CONTAINER" \
      bash -c 'ls -A /var/www/html 2>/dev/null | grep -qv -e "^\.git$" -e "^\.ddev$"'; then
    echo "error: /var/www/html is empty in the sidecar" >&2
    echo "hint:  check the bind mount with: ddev claude shell -c 'ls /var/www/html'" >&2
    exit 1
  fi
}

# Claude Code writes .credentials.json by write-temp-then-rename, which
# replaces the inode — so a single-file bind mount would keep pointing at the
# old inode and silently stop updating the host copy. We copy it out on exit
# instead. Any failure here warns and is otherwise ignored: it must never
# change the session's exit code.
#
# launch_claude both traps this on EXIT/INT/TERM (to cover an interrupt while
# docker exec is in the foreground) and calls it explicitly after the trap is
# cleared (to cover the normal exit path). On an interrupt bash runs the trap
# and then *resumes* the script, so both paths fire for the same session —
# this flag makes the body idempotent. Plain global, not local, so it
# survives being set by the trap invocation and checked again by the
# explicit call.
_credentials_snapshotted=0

snapshot_credentials() {
  if [[ "$_credentials_snapshotted" == "1" ]]; then
    return 0
  fi
  _credentials_snapshotted=1

  local dest="${DDEV_APPROOT}/.ddev/.claude"
  mkdir -p "$dest" 2>/dev/null || return 0
  docker cp "${CONTAINER}:/home/claude/.claude/.credentials.json" \
            "${dest}/.credentials.json" >/dev/null 2>&1 \
    || echo "warning: could not snapshot credentials from the sidecar" >&2
  return 0
}

launch_claude() {
  ensure_running
  ensure_firewall
  ensure_workspace

  local args=()
  if [[ "${CLAUDE_SAFE:-0}" != "1" ]]; then
    args+=(--dangerously-skip-permissions)
  fi

  # Deliberately NOT `exec`: we need to run snapshot_credentials afterwards.
  trap snapshot_credentials EXIT INT TERM
  local rc=0
  docker exec -it \
    --user claude \
    --workdir /var/www/html \
    "$CONTAINER" \
    claude "${args[@]+"${args[@]}"}" "$@" || rc=$?
  trap - EXIT INT TERM

  snapshot_credentials
  return "$rc"
}

rebuild_image() {
  bash "${DDEV_APPROOT}/.ddev/claude/build-image.sh"
  echo "Regenerated .ddev/claude/Dockerfile. Run 'ddev restart' to apply."
}

show_help() {
  cat <<'HELP'
Usage:
  ddev claude                  Interactive Claude Code session (YOLO mode).
  ddev claude safe             Same, but without --dangerously-skip-permissions.
  ddev claude shell [args]     Drop into bash inside the sidecar.
  ddev claude exec <cmd>       Run one command in the sidecar non-interactively.
  ddev claude rebuild          Regenerate Dockerfile from .ddev/claude.yaml.
  ddev claude state [dir]      Copy the sidecar's ~/.claude out to a directory
                               (default: .ddev/.claude.export).
  ddev claude help             Print this help.
  ddev claude <other args>     Pass through to the claude CLI (e.g. --resume).

Environment:
  CLAUDE_SAFE=1                Opt out of YOLO mode for this invocation.
  EXTRA_ALLOWED_DOMAINS=...    Space-separated extra outbound domains. Consumed
                               at container start — set before 'ddev restart'.

  Tool set and plugins are fixed by .ddev/claude.yaml and baked into the image.
  Change them with: ddev claude rebuild && ddev restart
HELP
}

case "${1:-}" in
  safe)
    shift
    CLAUDE_SAFE=1 launch_claude "$@"
    ;;
  shell)
    shift
    ensure_running
    ensure_firewall
    ensure_workspace
    exec docker exec -it --user claude --workdir /var/www/html "$CONTAINER" bash "$@"
    ;;
  exec)
    shift
    ensure_running
    ensure_firewall
    ensure_workspace
    exec docker exec -i --user claude --workdir /var/www/html "$CONTAINER" "$@"
    ;;
  rebuild)
    shift
    rebuild_image
    exit 0
    ;;
  state)
    shift
    ensure_running
    dest="${1:-${DDEV_APPROOT}/.ddev/.claude.export}"
    mkdir -p "$dest"
    docker cp "${CONTAINER}:/home/claude/.claude/." "$dest/"
    echo "Copied sidecar state to $dest"
    exit 0
    ;;
  help)
    show_help
    exit 0
    ;;
  *)
    launch_claude "$@"
    ;;
esac
